{
  "name": "smart-calendar-desktop",
  "version": "1.0.0",
  "description": "SmartCalendar 桌面版 - 全局热键一键保存日历事件",
  "main": "main.js",
  "author": "yingwang",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.smartcalendar.desktop",
    "productName": "SmartCalendar",
    "icon": "assets/icon.ico",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": null
    },
    "dmg": {
      "title": "SmartCalendar ${version}",
      "artifactName": "${productName}-${version}-${arch}.dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
